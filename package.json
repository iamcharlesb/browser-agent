{
  "name": "pilo",
  "productName": "Pilo",
  "version": "0.1.0",
  "private": true,
  "description": "Pilo \u2014 local, playbook-driven AI agent desktop runtime (Node.js + Electron).",
  "main": "electron/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:production": "tsc -p tsconfig.json --outDir build",
    "test": "npm run check:secrets && npm run build:test && node scripts/runTests.cjs",
    "benchmark:navigation": "npm run build && node scripts/benchmarkNavigation.cjs",
    "test:desktop": "npm run build && node scripts/testDesktop.js",
    "cli": "node dist/cli.js",
    "pilo": "node build/piloCli.js",
    "cli:package": "npm run check:secrets && node scripts/packageCli.cjs",
    "server": "node dist/server.js",
    "dev": "node scripts/dev.js",
    "built": "node scripts/built.js",
    "electron": "npm run build && electron .",
    "desktop": "node scripts/desktop.js",
    "desktop:dev": "node scripts/desktopDev.js",
    "desktop:built": "node scripts/desktop.js",
    "desktop:attach": "node scripts/desktop.js --attach",
    "build:test": "tsc -p tsconfig.json --outDir .test-dist",
    "check:secrets": "node scripts/checkSecrets.cjs",
    "profiles:review": "npm run build && node dist/reviewPlaybook.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "google-auth-library": "^10.1.0",
    "mongodb": "^6.21.0",
    "openai": "^4.60.0",
    "playwright": "^1.47.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "45.0.0",
    "typescript": "^5.8.2"
  },
  "allowScripts": {
    "electron@45.0.0": true
  },
  "license": "SEE LICENSE IN LICENSE"
}
