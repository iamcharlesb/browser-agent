{
  "name": "browser-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous browser agent powered by an OpenAI model and Playwright (Node.js port).",
  "main": "dist/promptLoop.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:production": "tsc -p tsconfig.json --outDir build",
    "test": "npm run build && node --test dist/security.test.js",
    "cli": "node dist/cli.js",
    "server": "node dist/server.js",
    "dev": "node scripts/dev.js",
    "built": "node scripts/built.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "google-auth-library": "^10.1.0",
    "openai": "^4.60.0",
    "playwright": "^1.47.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.2"
  }
}
