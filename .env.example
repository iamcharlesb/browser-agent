# Google OAuth web client ID (public identifier, never a client secret).
# Prefer copying GOOGLE_CLIENT_ID / NEXT_PUBLIC_GOOGLE_CLIENT_ID from SuperBuilder .env.local.
# Create an OAuth 2.0 Web client in Google Cloud Console → APIs & Services → Credentials.
# Add these to Authorized JavaScript origins (GIS Sign-In does not need GOOGLE_CLIENT_SECRET):
#   http://127.0.0.1:8765  (npm run dev)
#   http://127.0.0.1:8766  (npm run built / desktop:built — stable default; must be allowlisted)
# SuperBuilder often only has localhost:3000 / production — 8766 must still be added for Open Bots desktop.
# Plus any deployed app origin. Desktop pins 8766 so the GIS button keeps working across restarts.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Alias also accepted (SuperBuilder-compatible): NEXT_PUBLIC_GOOGLE_CLIENT_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional MongoDB Atlas (or any Mongo) URI for signed-in user persistence.
# Without this, Google users still get a verified session + local JSON under .browser-agent-users/.
# Guest mode never uses Mongo — bots/prefs stay in browser localStorage only.
# Example (redacted): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/openbots?retryWrites=true&w=majority
# MONGODB_URI=
# Database name inside the cluster (default: openbots)
# MONGODB_DB=openbots

# Model provider keys (optional if using a local model / Ollama / Claude CLI).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional absolute path to the Claude Code CLI binary (defaults to `claude` on PATH).
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude
