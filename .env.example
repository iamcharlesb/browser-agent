# Google OAuth web client ID (public identifier, never a client secret).
# Add http://127.0.0.1:8765 (dev), http://127.0.0.1:8766 (built), and your deployed app origin to Authorized JavaScript origins.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Model provider keys (optional if using a local model / Ollama).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
