# Pilo quick setup: copy this file to .env. Never commit .env or paste keys in chat.
# Settings → Connect a model provider can save the same values without editing this file.
# Choose openai, qwen, kimi, anthropic, xai, ollama, or compatible.
BROWSER_AGENT_PROVIDER=openai
# Leave blank to use the selected provider's model below.
BROWSER_AGENT_MODEL=
# Only fill the key for the provider you choose. The others can stay blank.
OPENAI_API_KEY=
QWEN_API_KEY=
KIMI_API_KEY=
# Aliases accepted: DASHSCOPE_API_KEY (Qwen), MOONSHOT_API_KEY (Kimi).
OPENAI_MODEL=gpt-5-mini
QWEN_MODEL=qwen3.5-plus
KIMI_MODEL=kimi-k3.1-pro
OPENAI_BASE_URL=https://api.openai.com/v1
# Qwen international/Singapore preset. Change to your API Host for other regions/workspaces.
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
KIMI_BASE_URL=https://api.moonshot.ai/v1
OPENAI_API_MODE=responses
QWEN_API_MODE=chat
KIMI_API_MODE=responses
# Another OpenAI-compatible service needs its own key, model and endpoint.
# COMPATIBLE_API_KEY=
# COMPATIBLE_MODEL=
# COMPATIBLE_BASE_URL=
# COMPATIBLE_API_MODE=chat

# Everything below is optional. Google sign-in and MongoDB are not needed to start.
# Google OAuth web client ID (public identifier, never a client secret).
# Prefer copying GOOGLE_CLIENT_ID / NEXT_PUBLIC_GOOGLE_CLIENT_ID from SuperBuilder .env.local.
# Create an OAuth 2.0 Web client in Google Cloud Console → APIs & Services → Credentials.
# Add these to Authorized JavaScript origins (GIS Sign-In does not need GOOGLE_CLIENT_SECRET):
#   http://127.0.0.1:8765  (npm run dev)
#   http://localhost:8765  (also add if you open the dev app as localhost)
#   http://127.0.0.1:8766  (npm run built / desktop:built — stable default; must be allowlisted)
#   http://localhost:8766  (also add if you open the built app as localhost)
# SuperBuilder often only has localhost:3000 / production — 8766 must still be added for Pilo desktop.
# Plus any deployed app origin. Desktop pins 8766 so the GIS button keeps working across restarts.
# Also add these to Authorized redirect URIs (and the matching callback for deployed origins):
#   http://127.0.0.1:8765/api/auth/google/callback
#   http://localhost:8765/api/auth/google/callback
#   http://127.0.0.1:8766/api/auth/google/callback
#   http://localhost:8766/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# Alias also accepted (SuperBuilder-compatible): NEXT_PUBLIC_GOOGLE_CLIENT_ID
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Optional MongoDB Atlas (or any Mongo) URI for signed-in user persistence.
# Without this, Google users still get a verified session + local JSON under .browser-agent-users/.
# Guest mode never uses Mongo — bots/prefs stay in browser localStorage only.
# Example (redacted): mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/openbots?retryWrites=true&w=majority
# MONGODB_URI=
# Database name inside the cluster (default: openbots)
# MONGODB_DB=openbots
# Shared event relay is enabled only when all installations use MongoDB and the same explicit ID.
# This is a single-operator trust boundary; a workspace ID is not account isolation or authorization.
# BROWSER_AGENT_EVENT_RETENTION_DAYS=30
# BROWSER_AGENT_EVENT_RETRY_MS=15000

# Model provider keys (optional if using a local model / Ollama / Claude CLI).
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Optional absolute path to the Claude Code CLI binary (defaults to `claude` on PATH).
# CLAUDE_CLI_PATH=/Users/you/.local/bin/claude

# Model versions and runtime limits (existing selections preserved; not an upgrade).
ANTHROPIC_MODEL=claude-sonnet-4-5
XAI_MODEL=grok-2-vision-1212
OLLAMA_MODEL=llama3.2
OPENAI_IMAGE_MODEL=gpt-image-2
BROWSER_AGENT_MAX_STEPS=25
BROWSER_AGENT_MAX_OUTPUT_TOKENS=4096
BROWSER_AGENT_CONTEXT_CHARS=64000
BROWSER_AGENT_CONTEXT_KEEP_TURNS=2
BROWSER_AGENT_TOOL_RESULT_CHARS=1400
BROWSER_AGENT_REASONING_EFFORT=low
BROWSER_AGENT_MODELS_JSON=[{"id":"gpt-4o-mini","provider":"openai","api":"chat"},{"id":"gpt-4o","provider":"openai","api":"chat"},{"id":"claude-haiku-4-5","provider":"anthropic","api":"chat"},{"id":"claude-opus-4-5","provider":"anthropic","api":"chat"},{"id":"ollama:qwen2.5-coder","provider":"ollama","api":"chat"}]

# Optional prices per million tokens. Unknown models show no cost estimate.
MODEL_PRICING_JSON={}
# Optional separate model for learn-mode patch proposals.
# BROWSER_AGENT_PATCH_MODEL=
BROWSER_AGENT_MAX_DURATION_SECONDS=900

# One retry owner: transient errors only.
BROWSER_AGENT_API_ATTEMPTS=3
BROWSER_AGENT_MODEL_TIMEOUT_MS=120000

# Compact runtime profiles, shared Mongo playbooks, event relay, and workflow state use a common workspace ID.
# BROWSER_AGENT_WORKSPACE_ID=
# Keep it as `local` or unset to disable shared events. For cross-installation coordination,
# use the same private, stable value on each trusted installation.
# BROWSER_AGENT_PROFILE_DIR=/absolute/path/to/profile-directory
BROWSER_AGENT_CORE_PROFILE_CHARS=2400
# Owner-authored bot profile, applied on each interactive turn; over-limit profiles fail explicitly.
BROWSER_AGENT_OWNER_PROFILE_CHARS=12000
BROWSER_AGENT_PLAYBOOK_CHARS=3200
BROWSER_AGENT_MAX_PLAYBOOKS=2
BROWSER_AGENT_REVIEWED_PLAYBOOK_CHARS=1200
BROWSER_AGENT_PLAYBOOK_RETRY_MS=15000

# Whole-discussion budgets; final synthesis runs once with its own small budget.
BROWSER_AGENT_MAX_CONCURRENT_RUNS=4
BROWSER_AGENT_MAX_PENDING_RUNS=50
BROWSER_AGENT_MAX_DISCUSSION_ROUNDS=4
BROWSER_AGENT_MAX_CONSULTATIONS_PER_BOT=2
BROWSER_AGENT_MAX_DISCUSSION_SECONDS=180
BROWSER_AGENT_DISCUSSION_REPEAT_PERCENT=85
BROWSER_AGENT_DISCUSSION_CONTEXT_CHARS=12000
# Saved workflow output and downstream handoff context budgets.
BROWSER_AGENT_WORKFLOW_RESULT_CHARS=6000
BROWSER_AGENT_WORKFLOW_CONTEXT_CHARS=12000
# Retry connecting to the same Chrome session, never replay page actions.
BROWSER_AGENT_CDP_CONNECT_ATTEMPTS=2
BROWSER_AGENT_CDP_CONNECT_TIMEOUT_MS=10000
# Separate named browser login sessions. Default retains the existing session.
BROWSER_AGENT_MAX_BROWSER_PROFILES=20
BROWSER_AGENT_PROFILE_PORT_BASE=9400
BROWSER_AGENT_SPECIALIST_MAX_STEPS=24
BROWSER_AGENT_SYNTHESIS_MAX_STEPS=12
BROWSER_AGENT_SYNTHESIS_MAX_SECONDS=60

# Read-only project folder imports (source snapshots, retrieved on demand).
BROWSER_AGENT_PROJECT_MAX_FILES=2000
BROWSER_AGENT_PROJECT_MAX_FILE_BYTES=256000
BROWSER_AGENT_PROJECT_MAX_BYTES=8000000

# Local reusable code retrieval: offline, no watchers or embedding/model calls.
BROWSER_AGENT_CODE_MAX_FILES=5000
BROWSER_AGENT_CODE_MAX_FILE_BYTES=1000000
BROWSER_AGENT_CODE_MAX_BYTES=32000000
BROWSER_AGENT_CODE_CHUNK_LINES=60
BROWSER_AGENT_CODE_MAX_CHUNKS=12000
BROWSER_AGENT_CODE_RESULTS=6
BROWSER_AGENT_CODE_RESULT_CHARS=6000
# Preserve bounded code pages and pagination in the token-lean engine.
BROWSER_AGENT_CODE_TOOL_RESULT_CHARS=16000
BROWSER_AGENT_CODE_READ_LINES=100
BROWSER_AGENT_CODE_GIT_TIMEOUT_MS=10000
# BROWSER_AGENT_CODE_INDEX_DIR=/absolute/private/cache-directory

# Browserless research. web_search uses an Agents SDK sub-agent with OpenAI hosted web search
# when OPENAI_API_KEY is set (even if chat uses another provider); otherwise it falls back to a
# keyless DuckDuckGo/Wikipedia lookup. Set the backend to scrape to never use hosted search.
BROWSER_AGENT_SEARCH_BACKEND=auto
# Leave blank to use OPENAI_MODEL for search.
BROWSER_AGENT_SEARCH_MODEL=
BROWSER_AGENT_SEARCH_MAX_TURNS=3
BROWSER_AGENT_SEARCH_CACHE_SECONDS=600
BROWSER_AGENT_SEARCH_CACHE_ENTRIES=50
# Characters of page text fetch_url returns to the model.
BROWSER_AGENT_FETCH_CHARS=6000
BROWSER_AGENT_FETCH_TIMEOUT_MS=10000
BROWSER_AGENT_FETCH_MAX_BYTES=2000000
BROWSER_AGENT_WATCH_SEEN_ITEMS=200
BROWSER_AGENT_WATCH_CHANGE_CHARS=3000
# Send topic tools (YouTube, Reddit, GA, coding, scheduling, images) only when the request mentions them.
BROWSER_AGENT_TOOL_PRUNING=on

# Hands-off operation. An unanswered approval is declined after this many seconds (0 waits forever).
BROWSER_AGENT_APPROVAL_TIMEOUT_SECONDS=900
# Limits for each scheduled or watcher-triggered run.
BROWSER_AGENT_SCHEDULE_MAX_STEPS=40
BROWSER_AGENT_SCHEDULE_MAX_SECONDS=1800

# Local screen recording: no model calls or external publishing.
BROWSER_AGENT_RECORDING_MAX_SECONDS=120
BROWSER_AGENT_RECORDING_MAX_BYTES=100000000
BROWSER_AGENT_RECORDING_BITRATE=8000000
BROWSER_AGENT_RECORDING_FPS=30
BROWSER_AGENT_RECORDING_POLL_MS=2000

# Optional local spoken demo guide (macOS speech or Linux eSpeak).
BROWSER_AGENT_DEMO_VOICE=
BROWSER_AGENT_DEMO_SPEECH_RATE=180
BROWSER_AGENT_DEMO_SPEECH_TIMEOUT_MS=15000
